import copy
import unittest

import oracle_prism_delta_tempo_speed_candidate_feed_v1 as candidate


def speed_card(pair="BTC/USD"):
    return {
        "pair": pair,
        "directional_context": "LONG",
        "market_type": "TREND",
        "structure": "ALIGNED",
        "tempo": "EXPANDING",
        "flow": "CONFIRMS",
        "shield": "CLEAR",
        "location": "RETEST",
        "review_state": "ARMED",
        "reason_codes": ["CONTEXT_CLEAR"],
        "context_claim": "CONTEXT_CLEAR",
        "context_score": 85,
        "tier": "BEST_NOW",
        "correlation_group": "LONG:TREND",
        "correlation_role": "PRIMARY",
        "micro_watchlist": True,
        "micro_state": "ARMED",
        "m5_speed_display": "WATCH-LONG",
        "kraken_spot_speed_companion": {
            "state": "AVAILABLE",
            "source": "kraken_spot_ohlc",
            "input_timeframe": "5m",
            "manual_review_only": True,
            "entry_authority": False,
            "speed_phase": {"direction": "LONG", "phase": "WATCH"},
        },
    }


def speed_review():
    cards = [speed_card("BTC/USD")]
    for index in range(1, 49):
        cards.append(speed_card(f"ASSET{index}/USD"))
    return {
        "recordtype": "ORACLEPROPFEEDKRAKENSPOTSPEEDREVIEW",
        "generated_at_utc": "2026-08-29T00:00:00Z",
        "context_generated_at_utc": "2026-08-29T00:00:00Z",
        "context_age_seconds": 0,
        "venue": "PROP",
        "universe": "APRIL_12_FIXED",
        "manual_review_only": True,
        "cards": cards,
    }


def prism_card(pair="BTC"):
    return {
        "pair": pair,
        "source_health": {"prism": {"state": "UNAVAILABLE", "reason": "fixture"}},
        "context": {"higher_timeframe": "LONG"},
        "prism_map": {
            "state": "UNAVAILABLE",
            "construction": "UNAVAILABLE",
            "fair_price_relationship": "UNAVAILABLE",
            "band_travel_state": "UNAVAILABLE",
            "routes_ranked": [],
            "map_quality": "UNAVAILABLE",
        },
        "confluence": {"score_relationship": "INDEPENDENT_NOT_COMBINED"},
        "risk": {
            "structural_invalidation": "UNAVAILABLE",
            "opposing_structure": "UNAVAILABLE",
            "available_distance": "UNAVAILABLE",
            "room_status": "UNAVAILABLE",
            "liquidation_coverage": "UNAVAILABLE",
            "risk_reasons": ["fixture"],
        },
        "display": {
            "attention_state": "OBSERVE",
            "manual_review_only": True,
            "entry_authority": False,
        },
    }


def prism_payload(cards=None):
    return {
        "recordtype": "PRISMADAPTERFEED",
        "schema_version": 1,
        "generated_at_utc": "2026-08-29T00:00:00Z",
        "manual_review_only": True,
        "trade_authority": False,
        "entry_authority": False,
        "does_not_send_alerts": True,
        "does_not_change_queue": True,
        "cards": cards if cards is not None else [prism_card()],
    }


class CandidateFeedTests(unittest.TestCase):
    def test_fixture_input_is_hard_blocked(self):
        payload = candidate.build_payload(speed_review(), prism_payload())
        self.assertFalse(payload["publish_eligible"])
        self.assertEqual(payload["publish_block_reason"], "prism_fixture_market_source")

    def test_exactly_49_unique_oracle_pairs_preserved(self):
        source = speed_review()
        payload = candidate.build_payload(source, prism_payload())
        self.assertEqual(len(payload["cards"]), 49)
        self.assertEqual(
            [card["pair"] for card in payload["cards"]],
            [card["pair"] for card in source["cards"]],
        )
        self.assertEqual(len({card["pair"] for card in payload["cards"]}), 49)

    def test_oracle_and_speed_are_preserved_without_combining_scores(self):
        source = speed_review()
        payload = candidate.build_payload(source, prism_payload())
        card = payload["cards"][0]
        self.assertEqual(card["oracle_context"]["context_score"], 85)
        self.assertEqual(card["kraken_spot_speed"]["display"], "WATCH-LONG")
        self.assertEqual(
            card["kraken_spot_speed"]["source"],
            source["cards"][0]["kraken_spot_speed_companion"],
        )
        self.assertNotIn("combined_score", card)
        self.assertEqual(
            card["prism"]["confluence"]["score_relationship"],
            "INDEPENDENT_NOT_COMBINED",
        )

    def test_delta_tempo_is_explicitly_unavailable(self):
        payload = candidate.build_payload(speed_review(), prism_payload())
        delta = payload["cards"][0]["delta_tempo_v2"]
        self.assertEqual(delta["state"], "UNAVAILABLE")
        self.assertIn("RUNTIME_SNAPSHOT_NOT_AVAILABLE", delta["source_status"])
        self.assertFalse(delta["entry_authority"])
        self.assertTrue(delta["manual_review_only"])

    def test_prism_base_asset_match_retains_source_identity(self):
        payload = candidate.build_payload(speed_review(), prism_payload([prism_card("BTC")]))
        prism = payload["cards"][0]["prism"]
        self.assertEqual(prism["source_pair"], "BTC")
        self.assertEqual(prism["pair_match_method"], "BASE_ASSET")
        self.assertEqual(prism["confluence"]["score_relationship"], "INDEPENDENT_NOT_COMBINED")

    def test_unmatched_prism_is_visible_and_not_invented(self):
        payload = candidate.build_payload(speed_review(), prism_payload([prism_card("ETH")]))
        prism = payload["cards"][0]["prism"]
        self.assertEqual(prism["state"], "UNAVAILABLE")
        self.assertEqual(prism["pair_match_method"], "NONE")
        self.assertEqual(prism["prism_map"]["state"], "UNAVAILABLE")
        self.assertIn("NO_PRISM_CARD_FOR_ORACLE_PAIR", prism["risk"]["risk_reasons"])

    def test_prism_safety_must_be_valid(self):
        invalid = prism_payload()
        invalid["trade_authority"] = True
        with self.assertRaisesRegex(ValueError, "prism_safety_invalid:trade_authority"):
            candidate.build_payload(speed_review(), invalid)

    def test_candidate_safety_invariants(self):
        payload = candidate.build_payload(speed_review(), prism_payload())
        self.assertEqual(payload["recordtype"], "ORACLEPRISMDELTATEMPOSPEEDCANDIDATEFEED")
        self.assertTrue(payload["manual_review_only"])
        self.assertFalse(payload["trade_authority"])
        self.assertFalse(payload["entry_authority"])
        self.assertTrue(payload["does_not_authorize_trade"])
        self.assertTrue(payload["does_not_send_alerts"])
        self.assertTrue(payload["does_not_change_queue"])
        for card in payload["cards"]:
            self.assertTrue(card["display"]["manual_review_only"])
            self.assertFalse(card["display"]["entry_authority"])


if __name__ == "__main__":
    unittest.main(verbosity=2)