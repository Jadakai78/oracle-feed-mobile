        "source_health": {
            "state": state,
            "source": "kraken_spot_ohlc",
            "timeframe": "15m",
            "last_completed_candle_utc": (
                "2026-08-29T00:00:00Z" if available else None
            ),
            "bar_count": 720 if available else 0,
            "required_bar_count": 390,
            "reason_codes": (
                [] if available else ["PRISM.DATA.MARKET_DATA_UNAVAILABLE"]
            ),
        },
        "context": {
            "direction": "UP" if available else "UNAVAILABLE",
            "regime": "TREND_UP" if available else "UNAVAILABLE",
            "location": "FAIR_VALUE_PROXIMATE" if available else "UNAVAILABLE",
            "activity_state": "NORMAL" if available else "UNAVAILABLE",
            "volatility_state": "NORMAL" if available else "UNAVAILABLE",
            "available_distance": "UNAVAILABLE",
