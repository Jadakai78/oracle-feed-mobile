def prism_runtime(cards=None):
    return {
        "recordtype": "PRISMRUNTIMESNAPSHOT",
        "schema_version": "prism.runtime-snapshot.v1",
        "generated_at_utc": "2026-08-29T00:00:00Z",
        "venue": "KRAKEN_SPOT",
        "universe": "APRIL_12_FIXED",
        "source_kind": "runtime_market_data",
        "fixture_market_source": False,
        "manual_review_only": True,
        "trade_authority": False,
        "entry_authority": False,
        "does_not_send_alerts": True,
        "does_not_change_queue": True,
        "health": {},
        "cards": cards if cards is not None else [runtime_card()],
    }


class CandidateFeedTests(unittest.TestCase):
    def test_runtime_input_remains_pending_review_not_publishable(self):
        payload = candidate.build_payload(speed_review(), prism_runtime())
        self.assertFalse(payload["publish_eligible"])
        self.assertEqual(
            payload["publish_block_reason"],
            "candidate_runtime_integration_not_yet_reviewed",
        )

    def test_exactly_49_unique_oracle_pairs_preserved(self):
        source = speed_review()
        payload = candidate.build_payload(source, prism_runtime())

        self.assertEqual(len(payload["cards"]), 49)
        self.assertEqual(
            [card["pair"] for card in payload["cards"]],
            [card["pair"] for card in source["cards"]],
        )
        self.assertEqual(len({card["pair"] for card in payload["cards"]}), 49)

    def test_speed_is_represented_as_delta_tempo_timing_without_mutation(self):
        source = speed_review()
        payload = candidate.build_payload(source, prism_runtime())

        card = payload["cards"][0]
        timing = card["delta_tempo_timing"]

        self.assertEqual(card["oracle_context"]["context_score"], 85)
        self.assertEqual(
            timing["presentation_role"],
            "DELTA_TEMPO_SPEED_TIMING",
        )
        self.assertEqual(
            timing["source_component"],
            "kraken_spot_speed_companion",
        )
        self.assertEqual(timing["state"], "AVAILABLE")
        self.assertEqual(timing["direction"], "LONG")
        self.assertEqual(timing["lifecycle_state"], "WATCH")
        self.assertEqual(
            timing["raw_source"],
            source["cards"][0]["kraken_spot_speed_companion"],
        )
        self.assertEqual(timing["flow_confirmation"]["state"], "DEFERRED")
        self.assertNotIn("combined_score", card)

    def test_runtime_prism_exact_match_is_available_and_source_owned(self):
        payload = candidate.build_payload(
            speed_review(),
            prism_runtime([runtime_card("BTC/USD")]),
        )

        prism = payload["cards"][0]["prism"]
        self.assertEqual(prism["state"], "AVAILABLE")
        self.assertEqual(prism["source_pair"], "BTC/USD")
        self.assertEqual(prism["pair_match_method"], "EXACT")
        self.assertEqual(prism["context"]["regime"], "TREND_UP")
        self.assertEqual(
            prism["prism_map"]["construction"],
            "STAIRSTEP_TREND",
        )
        self.assertEqual(
            prism["confluence"]["score_relationship"],
            "INDEPENDENT_NOT_COMBINED",
        )

    def test_runtime_prism_unavailable_is_visible_and_not_invented(self):
        payload = candidate.build_payload(
            speed_review(),
            prism_runtime([
                runtime_card("BTC/USD", "MARKET_DATA_UNAVAILABLE")
            ]),
        )

        prism = payload["cards"][0]["prism"]
        self.assertEqual(prism["state"], "UNAVAILABLE")
        self.assertEqual(prism["pair_match_method"], "EXACT")
        self.assertEqual(
            prism["source_health"]["state"],
            "MARKET_DATA_UNAVAILABLE",
        )
        self.assertEqual(prism["prism_map"]["state"], "UNAVAILABLE")
        self.assertIn(
            "PRISM.DATA.MARKET_DATA_UNAVAILABLE",
            prism["risk"]["risk_reasons"],
        )

    def test_runtime_prism_does_not_base_asset_match(self):
        payload = candidate.build_payload(
            speed_review(),
            prism_runtime([runtime_card("BTC/EUR")]),
        )

        prism = payload["cards"][0]["prism"]
        self.assertEqual(prism["state"], "UNAVAILABLE")
        self.assertEqual(prism["pair_match_method"], "NONE")
        self.assertIsNone(prism["source_pair"])
        self.assertIn(
            "NO_PRISM_RUNTIME_CARD_FOR_ORACLE_PAIR",
            prism["risk"]["risk_reasons"],
        )

    def test_runtime_prism_safety_must_be_valid(self):
        invalid = prism_runtime()
        invalid["trade_authority"] = True

        with self.assertRaisesRegex(
            ValueError,
            "prism_runtime_safety_invalid:trade_authority",
        ):
            candidate.build_payload(speed_review(), invalid)

    def test_runtime_prism_rejects_fixture_source(self):
        invalid = prism_runtime()
        invalid["fixture_market_source"] = True

        with self.assertRaisesRegex(
            ValueError,
            "prism_runtime_must_not_be_fixture_source",
        ):
            candidate.build_payload(speed_review(), invalid)

    def test_field_mode_defers_delta_cvd_and_pauses_micro_trigger(self):
        payload = candidate.build_payload(speed_review(), prism_runtime())

        self.assertEqual(payload["operating_mode"], "FIELD_READ_ONLY")
        self.assertIn("delta_tempo_timing", payload["enabled_sources"])
        self.assertEqual(
            payload["deferred_sources"]["delta_cvd"],
            "DEFERRED_NICHE_RETUNE",
        )
        self.assertEqual(
            payload["deferred_sources"]["micro_trigger"],
            "PAUSED_UNTIL_LOCAL_TRADING",
        )

    def test_candidate_safety_invariants(self):
        payload = candidate.build_payload(speed_review(), prism_runtime())

        self.assertEqual(
            payload["recordtype"],
            "ORACLEPRISMDELTATEMPOSPEEDCANDIDATEFEED",
        )
        self.assertTrue(payload["manual_review_only"])
        self.assertFalse(payload["trade_authority"])
        self.assertFalse(payload["entry_authority"])
        self.assertTrue(payload["does_not_authorize_trade"])
        self.assertTrue(payload["does_not_send_alerts"])
        self.assertTrue(payload["does_not_change_queue"])

        for card in payload["cards"]:
            self.assertTrue(card["display"]["manual_review_only"])
            self.assertFalse(card["display"]["entry_authority"])


if __name__ == "__main__":
    unittest.main(verbosity=2)